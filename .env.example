# API Configuration
# 请根据你使用的服务选择相应的配置

# ========================================
# 选项 1: OpenAI 官方 API
# ========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_API_BASE=  # 留空使用官方端点

# ========================================
# 选项 2: DeepSeek (推荐，性价比高)
# ========================================
# OPENAI_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_API_BASE=https://api.deepseek.com/v1

# ========================================
# 选项 3: SiliconFlow (硅基流动)
# ========================================
# OPENAI_API_KEY=sk-your-siliconflow-api-key-here
# OPENAI_API_BASE=https://api.siliconflow.cn/v1

# ========================================
# 选项 4: 其他兼容 OpenAI 的服务
# ========================================
# Azure OpenAI
# OPENAI_API_KEY=your-azure-api-key
# OPENAI_API_BASE=https://your-resource.openai.azure.com/openai/deployments/your-deployment

# Moonshot (月之暗面)
# OPENAI_API_KEY=sk-your-moonshot-api-key
# OPENAI_API_BASE=https://api.moonshot.cn/v1

# 智谱 AI (BigModel)
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 百度千帆
# OPENAI_API_KEY=your-qianfan-api-key
# OPENAI_API_BASE=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat

# 阿里云百炼
# OPENAI_API_KEY=sk-your-dashscope-api-key
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
